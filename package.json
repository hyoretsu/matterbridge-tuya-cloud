{
  "displayName": "Tuya",
  "name": "matterbridge-tuya",
  "version": "1.1.6",
  "description": "Matterbridge dynamic platform for Tuya and Smart Life cloud devices",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "bun tools/build.ts",
    "test": "bun test src tests",
    "test:unit": "bun test src",
    "test:integration": "bun test tests",
    "test:package": "bun tools/check-package.ts",
    "sdk:link": "bun tools/link-sdk.ts",
    "prepublishOnly": "bun run build && bun run test && bun run test:package",
    "lint": "bun node_modules/eslint/bin/eslint.js .",
    "prettier": "bun node_modules/prettier/bin/prettier.cjs --check ."
  },
  "keywords": [
    "matterbridge",
    "matterbridge-plugin",
    "tuya",
    "smartlife",
    "matter"
  ],
  "author": "Milo Cesar <milocesar1@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0",
    "matterbridge": ">=3.10.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyoretsu/matterbridge-tuya.git"
  },
  "bugs": {
    "url": "https://github.com/hyoretsu/matterbridge-tuya/issues"
  },
  "homepage": "https://github.com/hyoretsu/matterbridge-tuya#readme",
  "dependencies": {
    "axios": "^1.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "type": "module",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "matterbridge-tuya.config.json",
    "matterbridge-tuya.schema.json",
    "README.md",
    "LICENSE",
    "docs/business-rules.md"
  ],
  "packageManager": "bun@1.4.3"
}

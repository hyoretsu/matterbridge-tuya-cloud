{
  "displayName": "Tuya Cloud",
  "name": "matterbridge-tuya-cloud",
  "version": "0.1.8",
  "description": "Matterbridge Tuya Cloud",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "bun tools/build.ts",
    "test": "bun test --parallel src tests",
    "test:unit": "bun test --parallel src",
    "test:integration": "bun test --parallel tests",
    "test:package": "bun tools/check-package.ts",
    "sdk:link": "bun tools/link-sdk.ts",
    "prepublishOnly": "bun run build && bun run test && bun run test:package",
    "check": "bun node_modules/typescript/bin/tsc --project tsconfig.check.json",
    "lint": "bun node_modules/eslint/bin/eslint.js .",
    "prettier": "bun node_modules/prettier/bin/prettier.cjs --check ."
  },
  "keywords": [
    "matterbridge",
    "matterbridge-plugin",
    "tuya",
    "smartlife",
    "matter"
  ],
  "author": "Aran Leite",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0",
    "matterbridge": ">=3.10.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyoretsu/matterbridge-tuya-cloud.git"
  },
  "bugs": {
    "url": "https://github.com/hyoretsu/matterbridge-tuya-cloud/issues"
  },
  "homepage": "https://github.com/hyoretsu/matterbridge-tuya-cloud#readme",
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "type": "module",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "matterbridge-tuya-cloud.config.json",
    "matterbridge-tuya-cloud.schema.json",
    "README.md",
    "LICENSE",
    "docs/business-rules.md",
    "NOTICE"
  ],
  "packageManager": "bun@1.4.3"
}
